# Browser-visible configuration (Vercel + local frontend)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOY_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Optional local UI fixture mode. Never enable this in production.
NEXT_PUBLIC_KNOCK_DEMO_MODE=0

# Convex Cloud deployment configuration (set with `npx convex env set`)
CLERK_JWT_ISSUER_DOMAIN=
PRODUCT_HUNT_ACCESS_TOKEN=
TINYFISH_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
AGENTMAIL_API_KEY=
AGENTMAIL_WEBHOOK_SECRET=
# JSON map of Clerk user subjects to the AgentMail inbox IDs/addresses they own.
AGENTMAIL_INBOX_BINDINGS={"user_example":["inbox_example"]}

# Operational defaults (Convex Cloud; optional)
CONTACT_COOLDOWN_DAYS=90
KNOCK_APP_URL=https://your-app.vercel.app
